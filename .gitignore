# =========================
# Crystal Soul - Docs/Bootstrap repo .gitignore
# Keep repo clean, avoid secrets and heavy WP artifacts
# =========================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets (never commit)
.env
.env.*
*.key
*.pem
*.p12
*.crt
*.cer

# Backups / exports
*.zip
*.tar
*.tar.gz
*.sql
*.sql.gz
backups/
exports/

# WordPress (avoid committing a full site by mistake)
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/ai1wm-backups/
wp-content/updraft/
wp-content/wflogs/
wp-content/debug.log
error_log

# If you ever add a local WP environment folder, ignore it
.local/
